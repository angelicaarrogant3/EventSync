# Dependencies
node_modules/
server/node_modules/
clients/*/node_modules/

# Local environment files (secrets are auto-generated per machine)
.env
server/.env
clients/*/.env

# SQLite database files (keep data/.gitkeep)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal

# TLS certificates and private keys
*.pem
*.key
*.crt
certs/
data/certs/

# Logs & OS / Editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
