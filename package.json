{
  "name": "eventsync",
  "version": "1.0.0",
  "description": "EventSync: A Distributed Event Registration and Attendance Management System",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server/src/index.js",
    "start:https": "node -e \"process.env.HTTPS='true'; require('./server/src/index.js');\"",
    "start:info": "node server/src/index.js --info",
    "start:qr": "node server/src/index.js --qr",
    "share": "node scripts/share.js",
    "create-admin": "node scripts/create-admin.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo",
    "test": "node tests/run-all.js",
    "network-check": "node scripts/network-check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-forge": "^1.4.3",
    "pdfkit": "^0.16.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "distributed-systems",
    "eventsync",
    "attendance",
    "qr-verification",
    "socket-io",
    "offline-sync"
  ],
