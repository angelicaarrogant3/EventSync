{
  "cleanUrls": true,
  "redirects": [
    { "source": "/admin", "destination": "/admin/events", "type": 302 },
    { "source": "/user", "destination": "/user/events", "type": 302 }
  ],
  "headers": [
    { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
