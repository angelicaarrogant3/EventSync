{
  "buildCommand": "node tools/generate-config.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/verify/:code", "destination": "/verify.html" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/events" },
    { "source": "/user", "destination": "/user/events" }
  ]
}
