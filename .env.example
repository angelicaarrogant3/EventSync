# EventSync Configuration Template
# Copy to .env (or just run `npm start` to auto-generate random secrets on first run)

PORT=3000
HOST=0.0.0.0

# Plain HTTP is the default (no browser certificate warning).
# Set HTTPS=true (or run `npm run start:https`) when phone camera QR scanning is needed.
HTTPS=false
HTTP_ONLY=false

# Optional: Pin a specific LAN IP if multiple network interfaces exist
# SERVER_HOST=192.168.1.14

DB_PATH=./data/eventsync.db

# Generate strong random secrets before production use (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=change-me-generate-random-hex-secret
SESSION_TIMEOUT_MINUTES=120
QR_HMAC_SECRET=change-me-generate-random-hex-secret

# Optional first-run Administrator credentials for `npm run create-admin` (never commit real passwords)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@school.edu
# ADMIN_PASSWORD=

NODE_ID=node-1
NODE_ROLE=SERVER
HEARTBEAT_TIMEOUT_MS=15000
CORS_ORIGIN=*
LOG_REQUESTS=false
